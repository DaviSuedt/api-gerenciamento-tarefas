{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "2.0.0.0",
  "parameters": {
    "location": { "type": "string", "defaultValue": "eastus", "metadata": { "description": "Região do Azure App Service" } },
    "apiKey": { "type": "secureString", "minLength": 16, "metadata": { "description": "Chave secreta enviada no cabeçalho X-API-Key" } }
  },
  "variables": {
    "planName": "plan-gs-api-tarefas",
    "siteName": "gs-api-tarefas-davisuedt-20261030"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": { "name": "B1", "tier": "Basic", "size": "B1", "family": "B", "capacity": 1 },
      "properties": { "reserved": true }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('siteName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "dependsOn": ["[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "PYTHON|3.11",
          "appCommandLine": "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "alwaysOn": false,
          "http20Enabled": true,
          "appSettings": [
            { "name": "SCM_DO_BUILD_DURING_DEPLOYMENT", "value": "true" },
            { "name": "ENABLE_ORYX_BUILD", "value": "true" },
            { "name": "API_KEY", "value": "[parameters('apiKey')]" },
            { "name": "DATABASE_PATH", "value": "/home/data/tarefas.db" },
            { "name": "WEBSITES_PORT", "value": "8000" }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/sourcecontrols",
      "apiVersion": "2022-03-01",
      "name": "[format('{0}/web', variables('siteName'))]",
      "dependsOn": ["[resourceId('Microsoft.Web/sites', variables('siteName'))]"],
      "properties": {
        "repoUrl": "https://github.com/DaviSuedt/api-gerenciamento-tarefas",
        "branch": "main",
        "isManualIntegration": true
      }
    }
  ],
  "outputs": {
    "apiUrl": { "type": "string", "value": "[format('https://{0}.azurewebsites.net', variables('siteName'))]" },
    "swaggerUrl": { "type": "string", "value": "[format('https://{0}.azurewebsites.net/docs', variables('siteName'))]" },
    "sku": { "type": "string", "value": "B1 (Basic)" }
  }
}
